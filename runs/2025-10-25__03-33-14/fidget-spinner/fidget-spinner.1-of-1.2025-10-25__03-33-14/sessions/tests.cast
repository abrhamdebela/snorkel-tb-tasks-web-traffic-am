[25.814376, "o", "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_spinner_draws_all_layers\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Verify spinner() clears, rotates, and renders all required layers.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        spinner = _import_spinner()\u001b[90m\u001b[39;49;00m\r\n        spinner.state[\u001b[33m\"\u001b[39;49;00m\u001b[33mturn\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] = \u001b[94m25\u001b[39;49;00m  \u001b[90m# rotation should be turn / 10 -> 2.5 degrees\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        calls = []\u001b[90m\u001b[39;49;00m\r\n        orientation = {\u001b[33m\"\u001b[39;49;00m\u001b[33mvalue\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[94m0.0\u001b[39;49;00m}\u001b[90m\u001b[39;49;00m\r\n        forward_angles = []\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mlog\u001b[39;49;00m(name):\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mhandler\u001b[39;49;00m(*args, **kwargs):\u001b[90m\u001b[39;49;00m\r\n                calls.append((name, args, kwargs))\u001b[90m\u001b[39;49;00m\r\n    \u001b[90m\u001b[39;49;00m\r\n            \u001b[94mreturn\u001b"]
