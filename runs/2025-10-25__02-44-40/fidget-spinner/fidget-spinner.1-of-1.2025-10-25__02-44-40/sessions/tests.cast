[24.180984, "o", "      \u001b[90m# to avoid recursions in the getattr code in case of failure, we\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[90m# ensure that self.tk is always _something_.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[96mself\u001b[39;49;00m.tk = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n        \u001b[94mif\u001b[39;49;00m baseName \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mimport\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[04m\u001b[96mos\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n            baseName = os.path.basename(sys.argv[\u001b[94m0\u001b[39;49;00m])\u001b[90m\u001b[39;49;00m\r\n            baseName, ext = os.path.splitext(baseName)\u001b[90m\u001b[39;49;00m\r\n            \u001b[94mif\u001b[39;49;00m ext \u001b[95mnot\u001b[39;49;00m \u001b[95min\u001b[39;49;00m (\u001b[33m'\u001b[39;49;00m\u001b[33m.py\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m, \u001b[33m'\u001b[39;49;00m\u001b[33m.pyc\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\r\n                baseName = baseName + ext\u001b[90m\u001b[39;49;00m\r\n        interactive = \u001b[94mFalse\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\r\n>       \u001b[96mself\u001b[39;49;00m.tk = _tkinter.create(screenName, baseName, className, interactive"]
